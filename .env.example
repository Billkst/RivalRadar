# 火山方舟 Doubao(OpenAI 兼容端点)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL = endpoint ID,从 ARK 控制台获取,严禁提交到 git
DOUBAO_MODEL=

# 搜索 API(spike B 选型,默认 Tavily;EXA_API_KEY 可选作兜底)
TAVILY_API_KEY=
# EXA_API_KEY=

# 本地 SQLite
RIVALRADAR_DB=rivalradar.db

# 本地监听(默认 127.0.0.1:8000;跨主机访问设 RIVALRADAR_HOST=0.0.0.0)
# RIVALRADAR_HOST=127.0.0.1
# RIVALRADAR_PORT=8000

# 云部署见 DEPLOY.md(Render 注入 $PORT 时自动绑 0.0.0.0;secrets 在平台 Dashboard 配置,不写这里)
